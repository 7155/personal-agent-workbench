            "default": 4326,
            "required": true
          }
        ]
      },
      {
        "op": "set_crs",
        "desc": "Assign a CRS without transforming coordinates",
        "inputs": [
          {
            "role": "layer",
            "kind": "vector"
          }
        ],
        "args": [
          {
            "name": "crs",
            "type": "crs",
            "default": 4326,
            "required": true
          }
        ]
      },
      {
