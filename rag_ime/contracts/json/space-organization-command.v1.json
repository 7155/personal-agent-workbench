{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-ime.space-organization-command.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "spaceKey",
    "expectedRevision",
    "operation",
    "value"
  ],
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "spaceKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "enum": [
        "category",
        "placement",
        "pinned",
        "group",
        "proposal"
      ]
    },
    "value": {
      "type": [
        "string",
        "boolean"
      ],
      "maxLength": 100
    }
  }
}
